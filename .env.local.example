# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings > API > service_role secret. Server-only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Developers > API keys
STRIPE_SECRET_KEY=
# Developers > Webhooks > signing secret for the /api/stripe/webhook endpoint
STRIPE_WEBHOOK_SECRET=
# Product catalog > price id for the £19/month subscription
STRIPE_PRICE_ID=

# Base URL of this app, used for Stripe redirect/webhook URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ideal Postcodes — https://ideal-postcodes.co.uk. Optional: without it,
# the postcode field still works, address lookup just falls back to manual entry.
IDEAL_POSTCODES_API_KEY=

# Resend — https://resend.com. Used to email consultation requests to the
# Brightbox team. Free tier works without domain verification (sends from
# onboarding@resend.dev); verify your own domain there before going live.
RESEND_API_KEY=

# Anthropic — https://console.anthropic.com. Used to draft the energy
# efficiency survey's report from the customer's uploaded utility bills.
# Required for the energy survey feature; the rest of the app works without it.
ANTHROPIC_API_KEY=
